# Google Gemini API Key for generating insights
GEMINI_API_KEY=your_gemini_api_key_here

# Email configuration for sending the PDF report
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
EMAIL_ADDRESS=your_email@gmail.com
EMAIL_PASSWORD=your_app_password_here

# Optional: Google Sheets and Drive configuration
# Service account JSON file name (should be placed in the project root)
GOOGLE_APPLICATION_CREDENTIALS=service_account.json
# Google Sheet ID to append leads to
GOOGLE_SHEET_ID=your_google_sheet_id_here
# Google Drive Folder ID to upload the generated PDF
GOOGLE_DRIVE_FOLDER_ID=your_google_drive_folder_id_here
